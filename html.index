<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>STS IT Services | IT Consultancy & Career Support</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="STS IT Services - IT Consultancy, Project Support, Interview Assistance, Online Training and Career Guidance">
  
  <style>
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f8;
      color: #333;
    }

    /* HEADER */
    header {
      background: linear-gradient(135deg, #061a2d, #0b3c5d);
      color: white;
      padding: 20px 10px;
      text-align: center;
    }

    .logo-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .logo-container img {
      height: 70px;
      max-width: 100%;
    }

    .logo-text h1 {
      margin: 0;
      font-size: 30px;
    }

    .logo-text p {
      margin: 4px 0 0;
      font-size: 14px;
      color: #d6e6f2;
    }

    /* NAV */
    nav {
      background: #06283d;
      padding: 10px;
      text-align: center;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 15px;
      font-weight: bold;
    }

    nav a:hover {
      text-decoration: underline;
    }

    /* HERO */
    .hero {
      padding: 60px 20px;
      text-align: center;
      background: white;
    }

    .hero h2 {
      font-size: 28px;
      color: #0b3c5d;
    }

    .hero p {
      font-size: 18px;
      max-width: 800px;
      margin: auto;
      line-height: 1.6;
    }

    /* SECTIONS */
    .section {
      padding: 40px 20px;
      max-width: 1000px;
      margin: auto;
    }

    .section h2 {
      color: #0b3c5d;
      margin-bottom: 20px;
    }

    /* SERVICES */
    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .card h3 {
      margin-top: 0;
      color: #06283d;
    }

    /* CONTACT */
    .contact p {
      font-size: 16px;
      line-height: 1.8;
    }

    /* FOOTER */
    footer {
      background: #06283d;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 40px;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <!-- HEADER WITH LOGO -->
  <header>
    <div class="logo-container">
      <img src="logo.png" alt="STS IT Services Logo">
      <div class="logo-text">
        <h1>STS IT Services</h1>
        <p>Your Bridge to a Successful IT Career</p>
      </div>
    </div>
  </header>

  <!-- NAVIGATION -->
  <nav>
    <a href="#about">About</a>
    <a href="#services">Services</a>
    <a href="#contact">Contact</a>
  </nav>

  <!-- HERO SECTION -->
  <section class="hero">
    <h2>Build Your IT Career With Confidence</h2>
    <p>
      STS IT Services helps students and professionals with IT consultancy,
      real-time project support, interview assistance, and online training
      to succeed in today’s competitive IT industry.
    </p>
  </section>

  <!-- ABOUT -->
  <section id="about" class="section">
    <h2>About Us</h2>
    <p>
      STS IT Services is a professional IT consultancy focused on practical learning,
      real-time industry exposure, and honest career guidance. We specialize in
      helping freshers, OPT students, and working professionals grow confidently
      in their IT careers.
    </p>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section">
    <h2>Our Services</h2>

    <div class="services">
      <div class="card">
        <h3>Project Support</h3>
        <p>Real-time assistance for Java, SQL, Python, Power BI, and IT projects.</p>
      </div>

      <div class="card">
        <h3>Interview Assistance</h3>
        <p>Mock interviews, resume guidance, and real interview preparation.</p>
      </div>

      <div class="card">
        <h3>Online Training</h3>
        <p>Beginner to advanced IT training with hands-on practical sessions.</p>
      </div>

      <div class="card">
        <h3>Career Guidance</h3>
        <p>OPT / CPT guidance, job role selection, and long-term career planning.</p>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section contact">
    <h2>Contact Us</h2>
    <p>
      📧 Email: <b>support@stsitservices.com</b><br>
      📞 Phone / WhatsApp: <b>+1-XXX-XXX-XXXX</b><br>
      🌐 Website: <b>www.stsitservices.com</b>
    </p>
  </section>

  <!-- FOOTER -->
  <footer>
    <p>© 2026 STS IT Services. All Rights Reserved.</p>
    <p>Designed & Managed by STS IT Services</p>
  </footer>

</body>
</html>
